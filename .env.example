# Mock 模式（默认开启：无真实 MySQL 时使用内存数据）
USE_MOCK_DATA=true

# Database（接入 MySQL 后设置 USE_MOCK_DATA=false）
DATABASE_URL="mysql://user:password@localhost:3306/life_leap"

# Redis
REDIS_URL="redis://localhost:6379"

# Socket.IO (custom server)
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
