# Mock 模式（默认开启：无真实 MySQL 时使用内存数据）
USE_MOCK_DATA=true

# Database（接入 MySQL 后设置 USE_MOCK_DATA=false）
DATABASE_URL="mysql://user:password@localhost:3306/life_leap"

# Redis
REDIS_URL="redis://localhost:6379"

# Socket.IO（开发时独立端口；Render 上由 scripts/start-demo.mjs 收进公网 PORT）
SOCKET_PORT=3001
# 本地开发直连。生产构建若留空，浏览器会连当前页面来源的 /socket.io。
# NEXT_PUBLIC_* 在 next build / Docker 构建时写入前端，修改后必须重新构建。
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# App（Socket CORS 会允许这个来源；Render 还会自动允许 RENDER_EXTERNAL_URL）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 可选：额外浏览器来源，逗号分隔。自定义域名时填写，例如
# SOCKET_CORS_ORIGINS="https://play.example.com"
# 容器内 Next 端口，一般不用改。公网只使用 PORT（Render 会注入）。
# NEXT_INTERNAL_PORT=3010
# SOCKET_HOST=127.0.0.1
