{
  "name": "life-leap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:socket": "tsx watch socket/server.ts",
    "dev:all": "concurrently -n next,socket -c blue,green \"pnpm run dev\" \"pnpm run dev:socket\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test lib/rule-engine/circle-transition.test.ts lib/game-engine/finance-transition.test.ts lib/ceremony/detect-transition.test.ts socket/game-server.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "cards:import": "python3 scripts/import-cards-from-xlsx.py"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@prisma/client": "^6.8.2",
    "antd": "^5.25.4",
    "antd-mobile": "^5.39.0",
    "ioredis": "^5.6.1",
    "next": "^15.3.3",
    "pixi.js": "^8.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
